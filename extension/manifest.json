{
  "manifest_version": 3,
  "name": "Rekapin Meeting Recorder",
  "version": "0.9.0",
  "description": "Transkrip langsung rapat Google Meet, Zoom, dan panggilan WhatsApp Web, lalu kirim ke Rekapin.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "desktopCapture", "contextMenus", "offscreen", "storage", "tabs", "sidePanel"],
  "host_permissions": [
    "https://rekapin.contrivent.com/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_title": "Buka panel Rekapin",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "mulaiRekapin": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Mulai atau hentikan Rekapin di tab ini"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://web.whatsapp.com/*"],
      "js": ["speakerWatch.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
